# Julia project gitignore
# Keep Project.toml and Manifest.toml under version control.
# SVG, CSV and JLD2 result files are intentionally tracked.

# Julia depot and local package artifacts
.julia/
.juliaup/

# Julia compilation and binary artifacts
*.ji
*.so
*.dll
*.dylib
*.a
*.o

# Local Julia history and REPL state
.history
.history.jl
.repl_history

# Coverage, profiling and benchmark output
coverage/
*.cov
*.lcov
profiler/
profile/
benchmark_results/
benchmarks/results/

# Generated documentation and build output
docs/build/
docs/site/
_build/
build/
public/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Keep project results and data directories, but ignore only transient logs
results/logs/*
!results/logs/README.md

# Data and result files
# CSV and JLD2 are intentionally NOT ignored.
# They can be committed when they are documented and reproducible.
# *.csv
# *.jld2

# Preserve common scientific data formats not explicitly approved
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.mat
*.npz
*.npy
*.rds
*.sav

# Figures
# SVG and PNG are intentionally NOT ignored.
# They can be committed when generated by a documented script.
# *.svg
# *.png

# Large or temporary media
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.zip
*.tar
*.gz

# Pluto and notebook metadata
.pluto/
*.jl~
.ipynb_checkpoints/

# Python helper scripts and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Operating system files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini

# IDE and editor settings
.vscode/
.idea/
*.code-workspace

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
secrets/

# OS-specific temporary directories
tmp/
temp/
.cache/

# Keep the scientific project structure explicit
!Project.toml
!Manifest.toml
!src/
!test/
!chapters/
!docs/
!references/
!resources/
!data/
!results/
!figures/

# Explicitly track approved formats even if a parent rule is added later
!**/*.csv
!**/*.svg
!**/*.png
!**/*.jld2